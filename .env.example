# LLM Provider (OpenRouter — OpenAI-compatible)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick a free model that supports tool calling reasonably well.
# Check https://openrouter.ai/models?max_price=0 for the current live list before running.
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Postgres (used later once we add the DB step)
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_assistant